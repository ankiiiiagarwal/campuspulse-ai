# Supabase (create a free project, then run supabase/schema.sql and supabase/seed.sql)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq — Llama classify. If empty or the call fails, keyword fallback is used.
GROQ_API_KEY=

# Admin login (Supabase Auth user, or local cookie login when Supabase is not configured)
ADMIN_EMAIL=admin@campus.local
ADMIN_PASSWORD=campuspulse
ADMIN_SESSION_SECRET=change-me-before-deploy
