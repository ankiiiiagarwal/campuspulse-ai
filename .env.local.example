# Local JSON store in .data/store.json. Set to 1 to ignore remote Supabase entirely.
USE_LOCAL_DB=1

# Supabase (create a free project, then run supabase/schema.sql)
# Do not run supabase/seed.sql for a live empty campus — that file is optional demo data.
# Leave these empty (or keep USE_LOCAL_DB=1) so writes stay on this machine.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: set to 1 only if you want the demo seed tickets (not for the live app)
# LOAD_SEED=

# Gemini first for classify + student fix assistant (2.5 Flash, then 2.5 Flash-Lite).
# Groq is the next fallback. Keyword guides run if both fail.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Super-admin login (Supabase Auth user, or local cookie login when Supabase is not configured)
ADMIN_EMAIL=admin@campus.local
ADMIN_PASSWORD=campuspulse
# Production boot fails if this is missing, short, or still one of the sample values.
ADMIN_SESSION_SECRET=change-me-before-deploy

# Department desks — local cookie login (same password) and/or matching Supabase Auth users.
# Each account only sees issues routed to that department.
DEPT_PASSWORD=campuspulse
DEPT_IT_EMAIL=it@campus.local
DEPT_HOSTEL_EMAIL=hostel@campus.local
DEPT_MESS_EMAIL=mess@campus.local
DEPT_CAMPUS_EMAIL=campus@campus.local
DEPT_LIBRARY_EMAIL=library@campus.local
# Optional per-desk passwords: DEPT_IT_PASSWORD=...
# Only enable behind a proxy that replaces caller-supplied forwarding headers.
TRUST_PROXY_HEADERS=0
